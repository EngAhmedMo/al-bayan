{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    /* Path Resolution */
    "baseUrl": ".",
    "paths": {
      "*": [
        "*"
      ]
    },
    /* Explicitly include custom types */
    "typeRoots": [
      "./node_modules/@types",
      "./types"
    ]
  },
  "include": [
    ".",
    "types"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src",
    "New folder"
  ]
}