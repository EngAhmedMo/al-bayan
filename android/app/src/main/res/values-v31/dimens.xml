    <dimen name="text_size_hijri_month">18sp</dimen>
    <dimen name="text_size_hijri_year">14sp</dimen>
    
    <dimen name="text_size_pill">12sp</dimen>
    <dimen name="text_size_prayer">13sp</dimen>
    
    <dimen name="pill_padding_vertical">8dp</dimen>
    <dimen name="pill_padding_horizontal">12dp</dimen>
    <dimen name="pill_radius">16dp</dimen>
    
    <dimen name="widget_spacing_vertical">8dp</dimen>
